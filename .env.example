# ====== SERVER ======
NODE_ENV=development
PORT=5030

# ====== URLS ======
BASE_URL=http://localhost:5030
CLIENT_URL=http://localhost:3000
# Comma separated extra storefront/admin origins (add production domains here)
FRONTEND_URL=http://localhost:3000
SITE_URL=
SITE_NAME=Aamkahon

# ====== MONGODB ======
MONGODB_URI=mongodb+srv://USER:PASS@cluster.example.mongodb.net/amkahon

# ====== JWT ======
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE=30d
JWT_COOKIE_EXPIRE=30

# ====== SSLCOMMERZ ======
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_IS_SANDBOX=true

# ====== EMAIL (SMTP) ======
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Aamkahon <no-reply@example.com>"
# Where admin notifications (inquiries, pre-bookings) are sent
MAIL_TO=
MAIL_BRAND_COLOR=#D9740B
MAIL_BRAND_COLOR_DARK=#A85508

# ====== TAX ======
VAT_RATE=0

# ====== FILE UPLOAD ======
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=jpg,jpeg,png,webp,gif,avif
ALLOWED_IMAGE_TYPES=image/jpeg,image/jpg,image/png,image/webp,image/gif,image/avif

# Automatic wholesale tier (lower price at a box count). Off for Aamkahon:
# wholesale is agreed by phone. Must match NEXT_PUBLIC_WHOLESALE_TIER in the storefront.
WHOLESALE_TIER=off
